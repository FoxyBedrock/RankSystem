---
# Fork Foxy : chaque rank porte un "type".
# - type: moderation -> rank staff, un seul a la fois, toujours affiche
# - type: game       -> grade de joueur, cumulables, seul le plus haut est affiche

# ============ RANKS DE MODERATION (du plus haut au plus bas) ============
Owner:
  type: moderation
  nametag:
    prefix: "§l§c[§4Owner§c]§r "
    nameColor: "§c"
  chat:
    prefix: "§l§c[§4Owner§c]§r "
    nameColor: "§c"
    chatFormat: " §4» §f"
  permissions:
  # Fork Foxy : "*" = toutes les permissions enregistrees sur le serveur (equivalent op).
  # Les guillemets sont obligatoires : * nu est un alias YAML invalide.
  - "*"
  inheritance:
    - Admin
Admin:
  type: moderation
  nametag:
    prefix: "§9[§bAdmin§9]§r "
    nameColor: "§9"
  chat:
    prefix: "§9[§bAdmin§9]§r "
    nameColor: "§9"
    chatFormat: " §9» §f"
  permissions:
  - pocketmine.broadcast
  - pocketmine.command.gamemode
  - pocketmine.command.give
  - pocketmine.command.kick
  - pocketmine.command.teleport
  - pocketmine.command.time
  inheritance:
    - LeadMod
LeadMod:
  type: moderation
  nametag:
    prefix: "§5[§dLeadMod§5]§r "
    nameColor: "§5"
  chat:
    prefix: "§5[§dLeadMod§5]§r "
    nameColor: "§5"
    chatFormat: " §5» §f"
  permissions:
  - pocketmine.command.kick
  inheritance:
    - Mod
Mod:
  type: moderation
  nametag:
    prefix: "§2[§aMod§2]§r "
    nameColor: "§2"
  chat:
    prefix: "§2[§aMod§2]§r "
    nameColor: "§2"
    chatFormat: " §2» §f"
  permissions: []
  inheritance:
    - Helper
Helper:
  type: moderation
  nametag:
    prefix: "§3[§bHelper§3]§r "
    nameColor: "§3"
  chat:
    prefix: "§3[§bHelper§3]§r "
    nameColor: "§3"
    chatFormat: " §3» §f"
  permissions: []
  inheritance:
    - Dev
Dev:
  type: moderation
  nametag:
    prefix: "§6[§eDev§6]§r "
    nameColor: "§6"
  chat:
    prefix: "§6[§eDev§6]§r "
    nameColor: "§6"
    chatFormat: " §6» §f"
  permissions: []
  inheritance:
    - Teams
Teams:
  type: moderation
  nametag:
    prefix: "§1[§9Teams§1]§r "
    nameColor: "§1"
  chat:
    prefix: "§1[§9Teams§1]§r "
    nameColor: "§1"
    chatFormat: " §1» §f"
  permissions: []
  inheritance:
    - Friend
Friend:
  type: moderation
  nametag:
    prefix: "§d[§5Friend§d]§r "
    nameColor: "§d"
  chat:
    prefix: "§d[§5Friend§d]§r "
    nameColor: "§d"
    chatFormat: " §d» §f"
  permissions: []
  inheritance: []

